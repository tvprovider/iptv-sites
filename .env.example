# Namecheap API — used by namecheap-api.mjs for domain/DNS management.
# Requires the calling machine's public IP to be whitelisted in the
# Namecheap account under Profile > Tools > API Access.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=

# Resend — used by sites/4kstreaming-net/functions/api/*.js to send
# contact-form and trial-request emails. Set this in your hosting
# provider's dashboard (e.g. Cloudflare Pages > Settings > Environment
# variables), NOT just in this local file — the local .env is never
# deployed with the static build.
RESEND_API_KEY=
